{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/scripts/vault-health.py)",
      "Bash(python3 .claude/scripts/vault-health.py --json)",
      "Bash(python3 .claude/scripts/check-note-standard.py --file *)",
      "Bash(bash .claude/scripts/run-selfchecks.sh)",
      "Bash(bash .claude/scripts/operator-git.sh *)",
      "Bash(git status)",
      "Bash(git status --porcelain)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git log --output*)",
      "Bash(git diff --output*)",
      "Bash(cat *.env*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(cat *credentials*)",
      "Bash(cat *secrets*)",
      "Bash(head *.env*)",
      "Bash(head *.pem)",
      "Bash(head *.key)",
      "Bash(head *credentials*)",
      "Bash(head *secrets*)",
      "Bash(tail *.env*)",
      "Bash(tail *.pem)",
      "Bash(tail *.key)",
      "Bash(tail *credentials*)",
      "Bash(tail *secrets*)",
      "Bash(grep *.env*)",
      "Bash(grep *.pem)",
      "Bash(grep *.key)",
      "Bash(grep *credentials*)",
      "Bash(grep *secrets*)",
      "Bash(sed *.env*)",
      "Bash(sed *.pem)",
      "Bash(sed *.key)",
      "Bash(awk *.env*)",
      "Bash(awk *.pem)",
      "Bash(awk *.key)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials/**)",
      "Read(**/secrets/**)",
      "Read(**/.obsidian/plugins/*/data.json)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/check-daily-log.sh",
            "timeout": 15,
            "statusMessage": "Checking today's daily note was updated (rule 2)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/nudge-wikilinks.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/guard-daily-overwrite.py",
            "timeout": 5,
            "statusMessage": "Checking the daily is edited in place, not replaced (rule 8)..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/guard-vault-root.py",
            "timeout": 5,
            "statusMessage": "Checking nothing new lands in the vault root (rule 9)..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/guard-daily-overwrite.py",
            "timeout": 5,
            "statusMessage": "Checking no command discards a daily (rule 8)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/check-note-standard.py",
            "timeout": 5,
            "statusMessage": "Checking frontmatter and Summary line (rule 4)..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/nudge-move-linkcheck.py",
            "timeout": 5,
            "statusMessage": "Checking a moved page did not dangle inbound links (rule 10)..."
          }
        ]
      }
    ]
  }
}
